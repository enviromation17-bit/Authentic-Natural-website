{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authentic-natural-website",
  "compatibility_date": "2026-11-05",
  "main": "cloudflare/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "authentic-naturals-crm",
      "database_id": "7436d07e-be61-4bd5-8db0-219aae1de421"
    }
  ]
}
