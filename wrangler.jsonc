{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "authentic-natural-website",
  "compatibility_date": "2026-11-05",
  "main": "cloudflare/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  }
}
